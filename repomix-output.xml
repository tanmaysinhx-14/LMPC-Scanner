_CURRENCY_PREFIX = r"(?:MRP|USP|#|U|V|₹|Rs\.?|INR)"
_AMOUNT = re.compile(r"(?<!\w)(\d{1,4}(?:[., ]\d{2})?)(?!\w)")
_PRICE_PAIR = re.compile(
    r"(?P<mrp>\d{1,4}(?:[., ]\d{2})?)\s*/\s*\(?\s*"
    r"(?P<usp>\d{1,4}(?:[., ]\d{2})?)",
