_FSSAI = re.compile(r"(?<!\d)(?P<license>\d(?:[\s-]*\d){13})(?!\d)")
_TOLL_FREE = re.compile(
    r"(?<!\d)(?:\+?91[\s-]*)?(?P<number>(?:1800|1860)(?:[\s-]*\d){6,10})(?!\d)",
