)
_DATE_ISO = re.compile(
    r"(?<!\d)(?P<year_iso>\d{4})\s*[-/.]\s*(?P<month_iso>\d{1,2})"
    r"\s*[-/.]\s*(?P<day_iso>\d{1,2})(?!\d)",
