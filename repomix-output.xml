_TIME = re.compile(r"\b\d{1,2}:\d{2}(?::\d{2})?\b")
_PINCODE = re.compile(r"(?<!\d)[1-9]\d{2}\s?\d{3}(?!\d)")
_EMAIL = re.compile(
