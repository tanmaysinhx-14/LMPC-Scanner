    r"(?:(?:packs?|pkts?|units?)|u)?\s*[x\u00d7*]\s*"
    r"(?P<weight>\d+(?:[.,]\d+)?)\s*"
    r"(?P<unit>kgs?|gms?|gm|mls?|ls?|mgs?|"
